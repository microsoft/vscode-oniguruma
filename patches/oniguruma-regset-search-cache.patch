+/* Search cache: a position-lead search to the end of the string keeps its
+   search ranges, and a later search in the same string from the position
+   where it stopped, or after, uses them. The caller must clear the cache
+   when the string changes at the same address. */
+ONIG_EXTERN
+void onig_regset_set_search_cache P_((OnigRegSet* set, int enable));
+ONIG_EXTERN
+void onig_regset_clear_search_cache P_((OnigRegSet* set));
 ONIG_EXTERN
 int onig_regset_search_with_param P_((OnigRegSet* set, const OnigUChar* str, const OnigUChar* end, const OnigUChar* start, const OnigUChar* range,  OnigRegSetLead lead, OnigOptionType option, OnigMatchParam* mps[], int* rmatch_pos));
 
