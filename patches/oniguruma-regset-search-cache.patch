+/* The number of regexes changes: the kept search ranges do not fit. */
+static void
+regset_drop_search_cache(OnigRegSet* set)
+{
+  if (IS_NOT_NULL(set->cache_sr)) {
+    xfree(set->cache_sr);
+    set->cache_sr = (SearchRange* )NULL;
+  }
+  set->cache_pos = NULL_UCHARP;
+}
